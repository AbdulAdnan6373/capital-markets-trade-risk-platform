p.notion.com","slack.com","figma.com","atlassian.net","asana.com","airtable.com","monday.com","miro.com","canva.com","mail.google.com","drive.google.com","docs.google.com","calendar.google.com","office.com","microsoft365.com","sharepoint.com","teams.microsoft.com","salesforce.com","force.com","hubspot.com","zoom.us","dropbox.com","box.com","docusign.com","okta.com","login.microsoftonline.com"],"urls":["https://accounts.google.com/v3/signin/","https://accounts.google.com/ServiceLogin","https://id.atlassian.com/login"]},"is_device_based":false,"passed":false},"208167308":{"name":"208167308","rule_id":"6dhxyVTZ2QnuuwpxDwUiA8:100.00:27-6dhxyUeWAye0b6RC2oYFh6","secondary_exposures":[{"gate":"3029657650","gateValue":"false","ruleID":"default"},{"gate":"2274846837","gateValue":"false","ruleID":"default"},{"gate":"3901104270","gateValue":"false","ruleID":"default"},{"gate":"1893643243","gateValue":"false","ruleID":"default"},{"gate":"2054053781","gateValue":"false","ruleID":"default"},{"gate":"3737660407","gateValue":"false","ruleID":"default"},{"gate":"3922602262","gateValue":"false","ruleID":"default"},{"gate":"1326334369","gateValue":"true","ruleID":"6XNtx5BnDu95sYciBN1U9z:100.00:9"},{"gate":"957497898","gateValue":"false","ruleID":"Bg20Kw8ydPcademg0qKQq:5.00:1"},{"gate":"1833787017","gateValue":"false","ruleID":"default"}],"version":627,"id_type":"userID","value":{"fiber_tool_call_elicitation_mode":"elicit_on_writes","automations_create_tool_additional_guidance":"Do NOT mention the automation id to the user in  your response.","fiber_generic_chatgpt_builtin_tool_references":[{"tool_type":"ToolRef","tool_id":"automations"},{"tool_type":"ToolRef","tool_id":"image_gen"}],"break_plugin_service_brte_history_chain":true,"legacy_completion_prompt":"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \n\nExamples for when to output `::SKIP_COMPLETION::`:\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\n\nThe `::SKIP_COMPLETION::` logic should only apply to this turn. This guidance is no longer applicable after the next user turn.","json_completion_prompt":"Complete the automation's work on every run, whether or not there is an update to send.\nUse the user's instructions to decide whether this run warrants notifying them, including\nrequested reminders and meaningful findings or changes.\n\nWhen the user should be notified, write your normal final response.\nWhen no notification is needed but the response should appear in the user's conversation history,\nmake your entire final response this JSON object with exactly these fields:\n{\"type\": \"skip_notification\", \"reason\": \"Your full response to the task\"}.\nWhen there is no useful update to add to the user's conversation history, omit reason and make your\nentire final response {\"type\": \"skip_notification\"}. Do not wrap the JSON in a code fence or add\ntext outside it.\n\nWrite reason as a fully natural assistant response addressed to the user. Include the useful\nfindings, details of the work you did, and relevant limitations or next steps, with the same\ndetail you would normally provide for the task. This response remains available in the run's\nhistory. It does not need to justify skipping a notification or discuss notification mechanics.\nUse normal prose and Markdown within the JSON string, escaping it as valid JSON.","enable_browser_tool":true,"condition_watch_jitter_radius_seconds":600,"personalized_task_card_read_timeout_seconds":0.225,"automations_create_plan_tool_additional_guidance":"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.","gaas_extra_features":{"multi_agent":true,"fast_mode":true},"max_active_automations":5,"slack_webhook_bot_membership_message_template":"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?","tool_model_instructions":"","bypass_chat_model_output":true,"additional_developer_message_prompt":"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \n\nExamples for when to output `::SKIP_COMPLETION::`:\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run","fiber_sync_suggestable_connectors_to_workspace":false,"fiber_use_generic_chatgpt_builtin_tools":true,"validate_automation_prompt_template":"","exact_schedule_proactive_start_offset_seconds":10,"max_messages_per_conversation":1000,"fiber_sync_hazelnut_skills_to_workspace":false,"active_task_limit_message_template":"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks or upgrading your plan.","override_default_tools":false,"enable_whisper":false,"automations_list_limit":25,"skip_completion_text":"::SKIP_COMPLETION::","automations_list_tool_additional_guidance":"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\n\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.","webhook_trigger_user_prompt_template":"{automation_prompt}\n\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\nWebhook family: {family}\nWebhook event:\n{normalized_event_json}","model_lane_override":"auto","max_iterations_per_hour":1,"exact_schedule_jitter_radius_seconds":300,"max_turns_per_conversation":175,"enable_file_export":true,"general_agent_invoked_system_hints":[],"private_peek_enabled":true},"is_device_based":false,"passed":true},"216490582":{"name":"216490582","rule_id":"default","secondary_exposures":[],"version":4,"id_type":"userID","value":{"url":"https://help.openai.com/articles/20001509"},"is_device_based":false,"passed":false},"217573384":{"name":"217573384","rule_id":"prestart","secondary_exposures":[],"version":22,"id_type":"userID","value":{},"is_device_based":false,"is_experiment_active":false,"is_user_in_experiment":false},"247832287":{"name":"247832287","rule_id":"default","secondary_exposures":[],"version":15,"id_type":"userID","value":{"payment_method_order":[]},"is_device_based":false,"passed":false},"301381018":{"name":"301381018","rule_id":"default","secondary_exposures":[],"version":10,"id_type":"userID","value":{},"is_device_based":false,"passed":false},"339548201":{"name":"339548201","rule_id":"default","secondary_exposures":[],"version":15,"id_type":"userID","value":{"log_every_ms":10000,"ignore_parent_id_mismatch":false,"websocket_idle_timeout_ms":180000,"log_every_n_events":0},"is_device_based":false,"passed":false},"364966874":{"name":"364966874","rule_id":"1RZoUtIic3ZqeCu1DnRBI6","secondary_exposures":[],"version":29,"id_type":"userID","value":{"new_static_onboarding_flow":true},"is_device_based":false,"group_name":"Test","is_experiment_active":true,"is_user_in_experiment":true},"383746455":{"name":"383746455","rule_id":"default","secondary_exposures":[],"version":5,"id_type":"userID","value":{"disable_hover_previews":false,"disable_image_thumbnails":false,"disable_local_indexing":false},"is_device_based":false,"passed":false},"423260384":{"name":"423260384","rule_id":"6NJlHgVs4yv6IKjq7JFCHV:100.00:2-6NJlHfgpCglCpkLuwBJZoT","secondary_exposures":[{"gate":"1073599153","gateValue":"true","ruleID":"5CQUgrycKWU5bmXawM38GZ:100.00:1"}],"version":33,"id_type":"userID","value":{"presets":[[{"reasoning_effort":"low","model":"gpt-5.6-terra"},{"reasoning_effort":"low","model":"gpt-5.6-sol"},{"reasoning_effort":"medium","model":"gpt-5.6-sol"},{"model":"gpt-6-astra","reasoning_effort":"low"},{"reasoning_effort":"medium","model":"gpt-6-astra"}],[{"reasoning_effort":"low","model":"gpt-5.6-terra"},{"model":"gpt-5.6-terra","reasoning_effort":"medium"},{"model":"gpt-5.6-terra","reasoning_effort":"high"},{"reasoning_effort":"xhigh","model":"gpt-5.6-terra"}]]},"is_device_based":false,"passed":true},"463876344":{"name":"463876344","rule_id":"layerAssignment","secondary_exposures":[],"version":52,"id_type":"userID","value":{},"is_device_based":false,"is_experiment_active":true,"is_user_in_experiment":false},"489084288":{"name":"489084288","rule_id":"default","secondary_exposures":[],"version":36,"id_type":"stableID","value":{"options":["google","apple","microsoft","email","phone_number"]},"is_device_based":true,"passed":false},"496655956":{"name":"496655956","rule_id":"default","secondary_exposures":[],"version":13,"id_type":"userID","value":{"codex_ambient_suggestions_safety_model_slug":"gpt-6-luna","codex_automation_model_slug":"gpt-5.6-terra","codex_safety_review_faster_model_slug":"gpt-5.6-luna","codex_cowork_opus_model_slug":"gpt-5.6-terra","codex_ephemeral_generation_model_slug":"gpt-6-luna","codex_ambient_suggestions_model_slug":"gpt-6-luna","codex_text_generation_model_slug":"gpt-5.6-luna","codex_cowork_sonnet_haiku_model_slug":"gpt-5.6-luna"},"is_device_based":false,"passed":false},"541754464":{"name":"541754464","rule_id":"default","secondary_exposures":[],"version":10,"id_type":"userID","value":{"enabled":true,"view":"onboarding_v3"},"is_device_based":false,"passed":false},"548821362":{"name":"548821362","rule_id":"default","secondary_exposures":[],"version":6,"id_type":"userID","value":{"eligible_upsell_context_ids":["codex","image_gen"]},"is_device_based":false,"passed":false},"574611634":{"name":"574611634","rule_id":"default","secondary_exposures":[],"version":15,"id_type":"userID","value":{"connector_link_policies":{"connector_2128aebfecb84f64a069897515042a44":{"link_created_at_min":"2026-03-03T22:00:00Z"}}},"is_device_based":false,"passed":false},"635008376":{"name":"635008376","rule_id":"1qXlgzd8O6lwp6u4B1uLvP:100.00:1-1qXlgxy6lOc25GW8ZTz8cN","secondary_exposures":[{"gate":"3612242227","gateValue":"false","ruleID":"2Y3kdFl1HVF2xBzA7MH25u:2.00:1"},{"gate":"2831404950","gateValue":"true","ruleID":"qsULhPO4uqwoeOWdF6OcX"}],"version":6,"id_type":"userID","value":{"show_see_all_plans_button":"enabled"},"is_device_based":false,"passed":true},"690365152":{"name":"690365152","rule_id":"default","secondary_exposures":[],"version":31,"id_type":"userID","value":{"sample_ratio":1,"enabled":true,"android_enabled":true,"ios_enabled":true},"is_device_based":false,"passed":false},"690794452":{"name":"690794452","rule_id":"targetingGate","secondary_exposures":[{"gate":"1698194209","gateValue":"false","ruleID":"default"},{"gate":"700086370","gateValue":"false","ruleID":"7wGKMG5gthfn3twYmASyeB"},{"gate":"3643162575","gateValue":"true","ruleID":"3N3v0gPwp1HzsCs5sPfKke"},{"gate":"4136617744","gateValue":"false","ruleID":"26iujld4K5MCAd77dzxs