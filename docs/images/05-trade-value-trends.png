el":"Spain","format":"ES([A-Z][0-9]{8}|[0-9]{8}[A-Z]|[A-Z][0-9]{7}[A-Z])","description":"European VAT number","country":"ES"},"jp_rn":{"supported":false,"reverse_charge":true,"country":"JP","description":"Japanese Registered Foreign Businesses Number","region":"JP","format":"[0-9]{5}","country_label":"Japan","verifiable":false,"placeholder":"12345","stripe_type":"jp_rn","type":"jp_rn"},"li_vat":{"type":"li_vat","reverse_charge":true,"placeholder":"12345","verifiable":false,"supported":true,"format":"[0-9]{5}","region":"EEA-GB-CH","country_label":"Liechtenstein","description":"Liechtensteinian VAT number","country":"LI","stripe_type":"li_vat"},"bd_bin":{"placeholder":"123456789-0123","format":"[0-9]{9}-[0-9]{4}","region":"BD","country":"BD","stripe_type":"bd_bin","description":"Bangladesh Business Identification Number","reverse_charge":true,"type":"bd_bin","verifiable":false,"country_label":"Bangladesh","supported":true},"sk_vat":{"country_label":"Slovakia","region":"EEA-GB-CH","type":"sk_vat","verifiable":true,"supported":true,"country":"SK","format":"SK[0-9]{10}","placeholder":"SK1234567891","stripe_type":"eu_vat","description":"European VAT number","reverse_charge":true},"kh_tin":{"description":"Cambodian Tax Identification Number","country":"KH","country_label":"Cambodia","verifiable":false,"format":"[0-9]{4}-[0-9]{9}","region":"KH","reverse_charge":true,"stripe_type":"kh_tin","supported":true,"placeholder":"1001-123456789","type":"kh_tin"},"ee_vat":{"type":"ee_vat","stripe_type":"eu_vat","verifiable":true,"region":"EEA-GB-CH","reverse_charge":true,"placeholder":"EE123456789","format":"EE[0-9]{9}","description":"European VAT number","supported":true,"country":"EE","country_label":"Estonia"},"lv_vat":{"supported":true,"placeholder":"LV12345678912","region":"EEA-GB-CH","description":"European VAT number","country_label":"Latvia","verifiable":true,"country":"LV","stripe_type":"eu_vat","format":"LV[0-9]{11}","reverse_charge":true,"type":"lv_vat"},"tr_tin":{"supporte